  "components": {
    "schemas": {
      "ApiErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationFieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ApiErrorDetail"
      },
      "ApiErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ApiErrorResponse"
      },
      "ChannelCardOut": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/ChannelOut"
          },
          "sample": {
            "$ref": "#/components/schemas/SampleMetadata"
          },
          "metrics": {
            "$ref": "#/components/schemas/ChannelMetricsOut"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "videos": {
            "items": {
              "$ref": "#/components/schemas/VideoOut"
            },
            "type": "array",
            "title": "Videos",
            "description": "Confirmed selected videos, including unknown view counts; oldest to newest, unknown dates last"
          },
          "source_video": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceVideoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "from_cache": {
            "type": "boolean",
            "title": "From Cache",
            "default": false
          },
          "quota_used_estimate": {
            "type": "integer",
            "title": "Quota Used Estimate",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "channel",
          "sample",
          "metrics",
          "summary",
          "videos",
          "fetched_at"
        ],
        "title": "ChannelCardOut"
      },
      "ChannelMetricsOut": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Selected videos with known views; no minimum sample threshold"
          },
          "median_views": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Views"
          },
          "mean_views": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Views"
          },
          "std_views": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Std Views"
          },
          "cv": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cv",
            "description": "Population std / mean"
          },
          "spike_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spike Ratio",
            "description": "Maximum / median"
          },
          "consistency": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consistency",
            "description": "Fraction with views >= 0.5 * median"
          },
          "max_views": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Views"
          },
          "min_views": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Views"
          },
          "avg_like_view": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Like View"
          },
          "avg_comment_view": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Comment View"
          },
          "like_view_count": {
            "type": "integer",
            "title": "Like View Count",
            "default": 0
          },
          "comment_view_count": {
            "type": "integer",
            "title": "Comment View Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "ChannelMetricsOut"
      },
      "ChannelOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "subscriber_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscriber Count"
          },
          "subscriber_count_hidden": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subscriber Count Hidden"
          },
          "view_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "View Count"
          },
          "video_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Count"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "uploads_playlist_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uploads Playlist Id"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "title": "ChannelOut"
      },
      "SampleMetadata": {
        "properties": {
          "rule": {
            "$ref": "#/components/schemas/SampleRule"
          },
          "selected_count": {
            "type": "integer",
            "title": "Selected Count"
          },
          "metric_count": {
            "type": "integer",
            "title": "Metric Count"
          },
          "uploads_scanned": {
            "type": "integer",
            "title": "Uploads Scanned"
          },
          "pages_scanned": {
            "type": "integer",
            "title": "Pages Scanned"
          },
          "unavailable_video_count": {
            "type": "integer",
            "title": "Unavailable Video Count",
            "default": 0
          },
          "unknown_duration_count": {
            "type": "integer",
            "title": "Unknown Duration Count",
            "default": 0
          },
          "excluded_duration_count": {
            "type": "integer",
            "title": "Excluded Duration Count",
            "default": 0
          },
          "unknown_date_count": {
            "type": "integer",
            "title": "Unknown Date Count",
            "default": 0
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To"
          },
          "stop_reason": {
            "type": "string",
            "enum": [
              "sample_full",
              "uploads_exhausted",
              "scan_limit"
            ],
            "title": "Stop Reason"
          },
          "target_reached": {
            "type": "boolean",
            "title": "Target Reached"
          },
          "scan_limit_reached": {
            "type": "boolean",
            "title": "Scan Limit Reached"
          }
        },
        "type": "object",
        "required": [
          "selected_count",
          "metric_count",
          "uploads_scanned",
          "pages_scanned",
          "stop_reason",
          "target_reached",
          "scan_limit_reached"
        ],
        "title": "SampleMetadata"
      },
      "SampleRule": {
        "properties": {
          "min_duration_seconds": {
            "type": "integer",
            "title": "Min Duration Seconds",
            "default": 180
          },
          "min_duration_exclusive": {
            "type": "boolean",
            "title": "Min Duration Exclusive",
            "default": true
          },
          "max_videos": {
            "type": "integer",
            "title": "Max Videos",
            "default": 30
          },
          "max_uploads_scanned": {
            "type": "integer",
            "title": "Max Uploads Scanned",
            "default": 200
          },
          "max_pages": {
            "type": "integer",
            "title": "Max Pages",
            "default": 4
          }
        },
        "type": "object",
        "title": "SampleRule"
      },
      "SearchVideosRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "title": "Query",
            "default": ""
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 50
          },
          "period": {
            "type": "string",
            "enum": [
              "all",
              "day",
              "week",
              "month",
              "year"
            ],
            "title": "Period",
            "default": "all"
          },
          "published_after": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published After"
          },
          "published_before": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published Before"
          },
          "relevance_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relevance Language"
          },
          "page_token": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048,
                "minLength": 1,
                "pattern": "^[^\\x00-\\x20\\x7f]+$"
              },
              {
                "type": "null"
              }
            ],
